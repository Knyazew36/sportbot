{
  "$comment": "Источник правды фирменного стиля. Значения сняты с apps/frontend/src/global.css — при смене цвета правим здесь и там.",
  "color": {
    "light": {
      "paper": "#fff8f1",
      "sheet": "#fffdf9",
      "ink": "#0a0a0a",
      "blue": "#006eff",
      "rule": "#e2e8f0",
      "danger": "#d92d20",
      "positive": "#12893a",
      "gold": "#a8720a"
    },
    "dark": {
      "paper": "#070d1a",
      "sheet": "#0c1527",
      "ink": "#fff8f1",
      "blue": "#4c97ff",
      "rule": "#1b2740",
      "danger": "#ff6b5e",
      "positive": "#5ee08a",
      "gold": "#f2c14e"
    },
    "$rose": "Розовая расцветка приложения ([data-palette='rose']). blue — «голос палитры» (малиновый), имя как в global.css",
    "rose": {
      "paper": "#fff5f8",
      "sheet": "#fffafc",
      "ink": "#1f0a14",
      "blue": "#d6246e",
      "rule": "#f3dbe5",
      "danger": "#c2410c"
    },
    "$roseDark": "Розовая тёмная — «сливовая ночь» (.dark[data-palette='rose'])",
    "roseDark": {
      "paper": "#1a0b14",
      "sheet": "#241020",
      "ink": "#fff5f8",
      "blue": "#ff6fa8",
      "rule": "#3a1e2f",
      "danger": "#ff8a5b"
    },
    "accent": {
      "mint": "#d1ffca",
      "voltage": "#fff100",
      "rest": "#ffdcae"
    }
  },
  "font": {
    "sans": "Onest",
    "display": "Oswald",
    "serif": "Cormorant",
    "mono": "JetBrains Mono"
  },
  "radius": {
    "default": 0,
    "pill": 60
  },
  "motion": {
    "$comment": "Черновик: утвердить вместе с айдентикой",
    "ease": {
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "punch": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": {
      "fast": 150,
      "base": 300,
      "slow": 600
    }
  },
  "video": {
    "reels": { "width": 1080, "height": 1920, "fps": 30 },
    "post": { "width": 1080, "height": 1350, "fps": 30 },
    "square": { "width": 1080, "height": 1080, "fps": 30 }
  }
}
