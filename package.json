{
  "name": "sport-bot",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@sportbot/mobile --filter=server",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "setup": "bash ./setup.sh",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "@front-cmdt/format": "^1.5.0",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.11.7",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
