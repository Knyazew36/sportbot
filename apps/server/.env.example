# ── Приложение ──────────────────────────────────────────────────────────────
# development — только локально: стек ошибки в ответе, коды из писем в логах, localhost в CORS.
# На сервере — production (он же дефолт, если переменная не задана)
NODE_ENV=development
PORT=4003
# Название проекта — в текстах ботов, письмах и уведомлениях
APP_NAME="My App"
# Часовой пояс расписаний уведомлений (сервер может жить в UTC)
APP_TIMEZONE="Europe/Moscow"
# Лендинг и веб-версия: ссылки в приветствии ботов; FRONTEND_URL (https) — ещё и адрес мини-приложения
SITE_URL=
FRONTEND_URL=
# Разрешённые origin через запятую; ".example.com" — домен со всеми поддоменами.
# localhost-адреса в development разрешены и так
HTTP_CORS="https://app.example.com"

# ── База данных ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/app?schema=public"

# ── Авторизация ─────────────────────────────────────────────────────────────
# Не короче 16 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET="change-me-change-me-change-me"
JWT_EXPIRES_IN="7d"

# ── Почта (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
MAIL_FROM="My App <noreply@example.com>"

# ── Платформенный администратор (npx prisma db seed) ────────────────────────
PLATFORM_ADMIN_EMAIL="knyazew.sv@gmail.com"
PLATFORM_ADMIN_PASSWORD='sdf'

# ── Мессенджеры ─────────────────────────────────────────────────────────────
# Необязательны: без токена и имени бота модуль мессенджера не подключается (см. src/messengers/app-messengers.ts)

# Telegram: токен от @BotFather, имя бота без @
TG_BOT_TOKEN=
TG_BOT_NAME=

# MAX: токен из кабинета партнёра, имя бота без @ (из него собираются ссылки https://max.ru/<bot>)
MAX_BOT_TOKEN=
MAX_BOT_NAME=

# Администратор спортбота: ему доступны /admin, заявки и жалобы.
# Проще всего — ник в мессенджере, без «@» (регистр не важен). Бот узнаёт ник, когда админ ему напишет.
ADMIN_TELEGRAM_USERNAME=
ADMIN_MAX_USERNAME=
# Надёжнее — числовой id: ник можно сменить, и права уйдут тому, кто его займёт. Можно задать и то и другое
ADMIN_TELEGRAM_ID=
ADMIN_MAX_ID=

# VK: токен сообщества с правом «Сообщения сообщества» и id сообщества
VK_BOT_TOKEN=
VK_GROUP_ID=
# Нужны только мини-приложению VK
VK_APP_ID=
VK_APP_SECRET=

# ── Загрузки ────────────────────────────────────────────────────────────────
# Каталог файлов (аватары, вложения) и предел размера одного файла в байтах
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
