<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Android 16: уведомление поднимается до Live Update (чип в статус-баре, Now Bar) -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <service
      android:name=".WorkoutLiveService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <!-- Обоснование для Google Play: зачем приложению specialUse -->
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Workout in progress: rest timer and current set on the lock screen" />
    </service>
    <receiver
      android:name=".WorkoutLiveActionReceiver"
      android:exported="false" />
  </application>
</manifest>
