# Скопировать в .env (или .env.local) и перезапустить Metro: npx expo start -c
# EXPO_PUBLIC_* вшивается в бандл при сборке, без перезапуска не подхватится.

# Android-эмулятор: 10.0.2.2 — это localhost ПК, где крутится сервер
EXPO_PUBLIC_API_URL=http://10.0.2.2:4003/api

# Физический телефон в той же Wi-Fi — IP ПК в локальной сети
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4003/api
